# Neon Postgres connection string (Neon gives you this with ?sslmode=require).
DATABASE_URL=postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/krishnaj?sslmode=require

# A separate, disposable Postgres database for the pytest suite — tests
# drop and recreate every table. A local Postgres instance or a throwaway
# Neon branch both work. Falls back to DATABASE_URL if unset (do NOT point
# it at your real data for that reason).
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/krishnaj_test

SQL_ECHO=false

# Comma-separated origins the browser is allowed to call this API from.
# Only matters for cross-origin setups — local dev (Vite on :5173 calling
# uvicorn on :8000) is the only case that needs it. The Vercel deployment
# serves the frontend and /api from the same domain, so those requests are
# same-origin and never trigger a CORS check; nothing to set there.
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Seed accounts — set real passwords before running `python -m app.seed`,
# never commit them. Read via Settings (same as DATABASE_URL above), not a
# separate shell export — pointing DATABASE_URL at Neon and running the
# script is the whole procedure.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_SURESH_USERNAME=suresh
SEED_SURESH_PASSWORD=
SEED_NEENA_USERNAME=neena
SEED_NEENA_PASSWORD=
