# Local dev only: Vite (:5173) and uvicorn (:8000) are separate servers, so
# this needs to be the backend's full absolute origin.
#
# In the Vercel deployment this is NOT set here — it's a Vercel dashboard
# environment variable, and its value is different: "/api" (a relative
# path), because there both the frontend and the API are served from the
# same domain under one Vercel project. This file only covers local dev.
VITE_API_URL=http://localhost:8000
